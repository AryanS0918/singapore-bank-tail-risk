# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
.ipynb_checkpoints/

# Generated market data and outputs can be recreated; keep repo lightweight.
data/raw/*.csv
data/interim/*.csv
data/processed/*.csv
outputs/figures/*.png
outputs/tables/*.csv
outputs/tables/*.md
outputs/presentation/*.pdf

# Keep placeholders
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!outputs/figures/.gitkeep
!outputs/tables/.gitkeep
!outputs/presentation/.gitkeep
